@model UTB.Aukce.Application.ViewModels.AuctionCatalogViewModel
@{
    ViewData["Title"] = "Katalog aukcí";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h2>Katalog aukcí</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-success">+ Vytvořit aukci</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" asp-action="Index" class="card card-body bg-light mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Hledat podle názvu nebo popisu</label>
            <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Např. iPhone, kolo..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Kategorie</label>
            <select name="categoryId" class="form-select">
                <option value="">-- Všechny kategorie --</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="onlyActive" value="true" id="onlyActiveCheck" checked="@Model.OnlyActive" />
                <input type="hidden" name="onlyActive" value="false" />
                <label class="form-check-label" for="onlyActiveCheck">Pouze aktivní aukce</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
        </div>
    </div>
</form>

@if (!Model.Auctions.Any())
{
    <div class="alert alert-info">Nebyly nalezeny žádné aukce odpovídající filtru.</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Auctions)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary">@item.CategoryName</span>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktivní</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ukončeno</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(item.Description.Length > 110 ? item.Description.Substring(0, 110) + "..." : item.Description)
                        </p>
                        <div class="mt-2">
                            <div class="fs-5 fw-bold text-success">@item.CurrentPrice.ToString("N0") Kč</div>
                            <div class="small text-muted">Počet příhozů: @item.BidCount | Prodejce: @item.SellerName</div>
                            <div class="small text-muted">Konec: @item.EndTime.ToString("dd. MM. yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detail a příhozy</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="ToggleWatchlist" method="post" class="d-inline">
                                <input type="hidden" name="auctionId" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-sm @(item.IsWatched ? "btn-warning" : "btn-outline-secondary")">
                                    @(item.IsWatched ? "★ Sledováno" : "☆ Sledovat")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}