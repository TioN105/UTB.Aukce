@using Microsoft.AspNetCore.Identity
@using UTB.Aukce.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <li class="nav-item">
                <a class="nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administrace</a>
            </li>
        }
        <li class="nav-item">
            <span class="nav-link text-dark">Přihlášen: <strong>@User.Identity?.Name</strong></span>
        </li>
        <li class="nav-item">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-dark">Odhlásit se</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Registrace</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Přihlášení</a>
        </li>
    }
</ul>