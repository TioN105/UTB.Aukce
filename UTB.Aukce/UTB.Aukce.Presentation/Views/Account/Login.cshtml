@model UTB.Aukce.Application.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Přihlášení";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2>Přihlášení</h2>
        <hr />
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Heslo</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Zapamatovat si mě</label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Přihlásit se</button>
        </form>

        <div class="card mt-4 border-info">
            <div class="card-header bg-info bg-opacity-10 fw-bold">
                Testovací účty (pro účely obhajoby)
            </div>
            <div class="card-body p-2">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>E-mail</th>
                            <th>Heslo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge bg-danger">Admin</span></td>
                            <td><code>admin@utb.cz</code></td>
                            <td><code>Admin123</code></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-warning text-dark">Manager</span></td>
                            <td><code>manager@utb.cz</code></td>
                            <td><code>Manager123</code></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-secondary">Customer</span></td>
                            <td><code>zakaznik@utb.cz</code></td>
                            <td><code>Zakaznik123</code></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}