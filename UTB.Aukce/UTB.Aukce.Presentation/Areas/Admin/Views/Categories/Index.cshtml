@model IEnumerable<CategoryViewModel>
@{
    ViewData["Title"] = "Správa kategorií";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h2>Správa kategorií</h2>
    <a asp-action="Create" class="btn btn-success">+ Nová kategorie</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Název</th>
                <th>Popis</th>
                <th style="width: 190px;">Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Upravit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Opravdu chcete smazat tuto kategorii?');">
                            <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>