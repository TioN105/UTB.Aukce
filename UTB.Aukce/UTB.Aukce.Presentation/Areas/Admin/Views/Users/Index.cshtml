@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Správa uživatelů";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h2>Správa uživatelů a rolí</h2>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Zpět do administrace</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Jméno a příjmení</th>
                <th>E-mail</th>
                <th>Role</th>
                <th>Registrace</th>
                <th style="width: 190px;">Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><strong>@user.FirstName @user.LastName</strong></td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Role == "Admin")
                        {
                            <span class="badge bg-danger">@user.Role</span>
                        }
                        else if (user.Role == "Manager")
                        {
                            <span class="badge bg-warning text-dark">@user.Role</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@user.Role</span>
                        }
                    </td>
                    <td>@user.RegisteredAt.ToLocalTime().ToString("dd. MM. yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Upravit</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Opravdu chcete smazat tohoto uživatele?');">
                            <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>